generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }
model User { id String @id @default(cuid()); email String? @unique; name String?; phone String? @unique; age Int?; education String?; category String?; state String?; gender String?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; documents Document[]; results TestResult[]; favorites Favorite[]; notifications Notification[] }
model Category { id String @id @default(cuid()); name String @unique; slug String @unique; exams Exam[] }
model State { id String @id @default(cuid()); name String @unique; code String @unique; exams Exam[] }
model Exam { id String @id @default(cuid()); name String; slug String @unique; organization String; categoryId String; stateId String?; vacancies String?; minAge Int?; maxAge Int?; qualifications String; eligibleCategories String[]; eligibleGenders String[]; examDate DateTime?; applicationLastDate DateTime?; applicationUrl String?; officialUrl String?; salary String?; syllabus Json?; pattern Json?; cutoff Json?; publishedAt DateTime @default(now()); updatedAt DateTime @updatedAt; category Category @relation(fields:[categoryId],references:[id]); state State? @relation(fields:[stateId],references:[id]); favorites Favorite[]; mockTests MockTest[] }
model Notification { id String @id @default(cuid()); userId String; title String; body String; channel String; sentAt DateTime?; createdAt DateTime @default(now()); user User @relation(fields:[userId],references:[id],onDelete:Cascade) }
model Document { id String @id @default(cuid()); userId String; type String; url String; expiresAt DateTime?; verified Boolean @default(false); createdAt DateTime @default(now()); user User @relation(fields:[userId],references:[id],onDelete:Cascade) }
model MockTest { id String @id @default(cuid()); examId String; title String; questions Json; durationMin Int; negativeMarking Float @default(0); exam Exam @relation(fields:[examId],references:[id],onDelete:Cascade); results TestResult[] }
model TestResult { id String @id @default(cuid()); userId String; mockTestId String; score Float; correct Int; incorrect Int; timeSeconds Int; analytics Json?; createdAt DateTime @default(now()); user User @relation(fields:[userId],references:[id],onDelete:Cascade); mockTest MockTest @relation(fields:[mockTestId],references:[id],onDelete:Cascade) }
model Blog { id String @id @default(cuid()); slug String @unique; title String; excerpt String; content String; published Boolean @default(false); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model Favorite { id String @id @default(cuid()); userId String; examId String; createdAt DateTime @default(now()); user User @relation(fields:[userId],references:[id],onDelete:Cascade); exam Exam @relation(fields:[examId],references:[id],onDelete:Cascade); @@unique([userId,examId]) }